# 	# crowdsec
#
# 	rate_limit {
# 		zone app_zone {
# 			key {remote_host}
# 			events 50
# 			window 10s
# 		}
# 	}
#
# 	reverse_proxy app:5050
# }

# --- Example C: Public static / CDN-like site WITH cache ---------------------
# Safe only for public, non-personalized responses.
# Requires global `cache { ttl … otter }` to be uncommented above.

# static.example.com {
# 	import security_headers
# 	import ping
# 	encode zstd gzip
#
# 	@cacheable {
# 		method GET HEAD
# 	}
# 	cache @cacheable
#
# 	root * /srv
# 	file_server
# }

# --- Example D: Cache in front of a public upstream (advanced) ---------------
# Only for clearly public GET/HEAD. Never enable for logged-in apps.

# cdn.example.com {
# 	import security_headers
#
# 	@cacheable {
# 		method GET HEAD
# 	}
# 	cache @cacheable
#
# 	reverse_proxy origin:8080
# }

